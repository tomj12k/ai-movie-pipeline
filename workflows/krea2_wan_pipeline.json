{
  "_meta_workflow": "Krea 2 style pass over a Blender wireframe, then Wan 2.2 I2V 14B (high+low noise MoE) — photoreal hero-shot lane, 81 frames @ 16fps (~5s). Expect 15-25 min on the Spark; run studio clear first when switching lanes.",

  "1":  {"class_type": "UNETLoader", "_meta": {"title": "krea2 dit"},
         "inputs": {"unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default"}},
  "2":  {"class_type": "CLIPLoader", "_meta": {"title": "krea2 text encoder"},
         "inputs": {"clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default"}},
  "3":  {"class_type": "VAELoader", "_meta": {"title": "qwen image vae"},
         "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "4":  {"class_type": "LoadImage", "_meta": {"title": "input_wireframe"},
         "inputs": {"image": "wireframe.png"}},
  "5":  {"class_type": "VAEEncode", "_meta": {"title": "grounded encode"},
         "inputs": {"pixels": ["4", 0], "vae": ["3", 0]}},
  "6":  {"class_type": "CLIPTextEncode", "_meta": {"title": "style_prompt"},
         "inputs": {"clip": ["2", 0],
                    "text": "photorealistic cinematic still, natural skin detail, dramatic lighting, 35mm lens, shallow depth of field"}},
  "7":  {"class_type": "CLIPTextEncode", "_meta": {"title": "style_negative"},
         "inputs": {"clip": ["2", 0],
                    "text": "wireframe lines, flat shading, cartoon, text, watermark, blurry"}},
  "8":  {"class_type": "KSampler", "_meta": {"title": "krea2 restyle (i2i)"},
         "inputs": {"model": ["1", 0], "positive": ["6", 0], "negative": ["7", 0],
                    "latent_image": ["5", 0], "seed": 7, "steps": 8, "cfg": 1.0,
                    "sampler_name": "euler", "scheduler": "simple", "denoise": 0.65}},
  "9":  {"class_type": "VAEDecode", "_meta": {"title": "styled frame"},
         "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
  "10": {"class_type": "SaveImage", "_meta": {"title": "keep style frame"},
         "inputs": {"images": ["9", 0], "filename_prefix": "studio/style_frame"}},

  "11": {"class_type": "UNETLoader", "_meta": {"title": "wan2.2 high noise"},
         "inputs": {"unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"}},
  "12": {"class_type": "UNETLoader", "_meta": {"title": "wan2.2 low noise"},
         "inputs": {"unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"}},
  "13": {"class_type": "ModelSamplingSD3", "_meta": {"title": "shift high"},
         "inputs": {"model": ["11", 0], "shift": 8.0}},
  "14": {"class_type": "ModelSamplingSD3", "_meta": {"title": "shift low"},
         "inputs": {"model": ["12", 0], "shift": 8.0}},
  "15": {"class_type": "CLIPLoader", "_meta": {"title": "umt5 for wan"},
         "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}},
  "16": {"class_type": "VAELoader", "_meta": {"title": "wan 2.1 vae"},
         "inputs": {"vae_name": "wan_2.1_vae.safetensors"}},
  "17": {"class_type": "CLIPTextEncode", "_meta": {"title": "motion_prompt"},
         "inputs": {"clip": ["15", 0],
                    "text": "smooth cinematic camera move, natural human motion, physically plausible cloth and hair, continuous single shot"}},
  "18": {"class_type": "CLIPTextEncode", "_meta": {"title": "motion_negative"},
         "inputs": {"clip": ["15", 0],
                    "text": "静止, 过曝, jitter, flicker, morphing, extra limbs, deformed hands, scene cut, watermark"}},
  "19": {"class_type": "WanImageToVideo", "_meta": {"title": "wan i2v 81f"},
         "inputs": {"positive": ["17", 0], "negative": ["18", 0], "vae": ["16", 0],
                    "start_image": ["9", 0], "width": 1280, "height": 720,
                    "length": 81, "batch_size": 1}},
  "20": {"class_type": "KSamplerAdvanced", "_meta": {"title": "high-noise steps 0-10"},
         "inputs": {"model": ["13", 0], "positive": ["19", 0], "negative": ["19", 1],
                    "latent_image": ["19", 2], "add_noise": "enable", "noise_seed": 7,
                    "steps": 20, "cfg": 3.5, "sampler_name": "euler", "scheduler": "simple",
                    "start_at_step": 0, "end_at_step": 10, "return_with_leftover_noise": "enable"}},
  "21": {"class_type": "KSamplerAdvanced", "_meta": {"title": "low-noise steps 10-20"},
         "inputs": {"model": ["14", 0], "positive": ["19", 0], "negative": ["19", 1],
                    "latent_image": ["20", 0], "add_noise": "disable", "noise_seed": 7,
                    "steps": 20, "cfg": 3.5, "sampler_name": "euler", "scheduler": "simple",
                    "start_at_step": 10, "end_at_step": 10000, "return_with_leftover_noise": "disable"}},
  "22": {"class_type": "VAEDecode", "_meta": {"title": "decode frames"},
         "inputs": {"samples": ["21", 0], "vae": ["16", 0]}},
  "23": {"class_type": "CreateVideo", "_meta": {"title": "assemble 16fps"},
         "inputs": {"images": ["22", 0], "fps": 16.0}},
  "24": {"class_type": "SaveVideo", "_meta": {"title": "save hero shot"},
         "inputs": {"video": ["23", 0], "filename_prefix": "studio/hero_wan",
                    "format": "mp4", "codec": "h264"}}
}
