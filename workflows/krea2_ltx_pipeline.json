{
  "_meta_workflow": "Krea 2 style pass over a Blender wireframe, then LTX-2.3 image-to-video. Primary 10s reel lane (241 frames @ 24fps). studio.py rewrites filename_prefix per project, uploads --image into node 4, and patches prompts via _meta titles.",

  "1":  {"class_type": "UNETLoader", "_meta": {"title": "krea2 dit"},
         "inputs": {"unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default"}},
  "2":  {"class_type": "CLIPLoader", "_meta": {"title": "krea2 text encoder"},
         "inputs": {"clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default"}},
  "3":  {"class_type": "VAELoader", "_meta": {"title": "qwen image vae"},
         "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "4":  {"class_type": "LoadImage", "_meta": {"title": "input_wireframe"},
         "inputs": {"image": "wireframe.png"}},
  "5":  {"class_type": "VAEEncode", "_meta": {"title": "grounded encode"},
         "inputs": {"pixels": ["4", 0], "vae": ["3", 0]}},
  "6":  {"class_type": "CLIPTextEncode", "_meta": {"title": "style_prompt"},
         "inputs": {"clip": ["2", 0],
                    "text": "cinematic still, dramatic volumetric lighting, 35mm anamorphic, rich color grade, ultra detailed, film grain"}},
  "7":  {"class_type": "CLIPTextEncode", "_meta": {"title": "style_negative"},
         "inputs": {"clip": ["2", 0],
                    "text": "wireframe lines, flat shading, low detail, text, watermark, blurry"}},
  "8":  {"class_type": "KSampler", "_meta": {"title": "krea2 restyle (i2i)"},
         "inputs": {"model": ["1", 0], "positive": ["6", 0], "negative": ["7", 0],
                    "latent_image": ["5", 0], "seed": 7, "steps": 8, "cfg": 1.0,
                    "sampler_name": "euler", "scheduler": "simple", "denoise": 0.65}},
  "9":  {"class_type": "VAEDecode", "_meta": {"title": "styled frame"},
         "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
  "10": {"class_type": "SaveImage", "_meta": {"title": "keep style frame"},
         "inputs": {"images": ["9", 0], "filename_prefix": "studio/style_frame"}},

  "11": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "ltx-2.3 22b distilled"},
         "inputs": {"ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors"}},
  "21": {"class_type": "LTXAVTextEncoderLoader", "_meta": {"title": "gemma 3 12b encoder"},
         "inputs": {"text_encoder": "gemma_3_12B_it_fp8_scaled.safetensors",
                    "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors", "device": "default"}},
  "12": {"class_type": "CLIPTextEncode", "_meta": {"title": "motion_prompt"},
         "inputs": {"clip": ["21", 0],
                    "text": "slow cinematic dolly-in on a 35mm lens, subject moves naturally, coherent physics, seamless continuous shot"}},
  "13": {"class_type": "CLIPTextEncode", "_meta": {"title": "motion_negative"},
         "inputs": {"clip": ["21", 0],
                    "text": "jitter, flicker, morphing, extra limbs, scene cuts, text, watermark"}},
  "14": {"class_type": "LTXVConditioning", "_meta": {"title": "24 fps conditioning"},
         "inputs": {"positive": ["12", 0], "negative": ["13", 0], "frame_rate": 24.0}},
  "15": {"class_type": "ModelSamplingLTXV", "_meta": {"title": "ltx shift"},
         "inputs": {"model": ["11", 0], "max_shift": 2.05, "base_shift": 0.95}},
  "16": {"class_type": "LTXVImgToVideo", "_meta": {"title": "img->video 241f"},
         "inputs": {"positive": ["14", 0], "negative": ["14", 1], "vae": ["11", 2],
                    "image": ["9", 0], "width": 1280, "height": 720, "length": 241,
                    "batch_size": 1, "strength": 1.0}},
  "17": {"class_type": "KSampler", "_meta": {"title": "ltx sample (distilled)"},
         "inputs": {"model": ["15", 0], "positive": ["16", 0], "negative": ["16", 1],
                    "latent_image": ["16", 2], "seed": 7, "steps": 8, "cfg": 1.0,
                    "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "18": {"class_type": "VAEDecode", "_meta": {"title": "decode frames"},
         "inputs": {"samples": ["17", 0], "vae": ["11", 2]}},
  "19": {"class_type": "CreateVideo", "_meta": {"title": "assemble 24fps"},
         "inputs": {"images": ["18", 0], "fps": 24.0}},
  "20": {"class_type": "SaveVideo", "_meta": {"title": "save reel"},
         "inputs": {"video": ["19", 0], "filename_prefix": "studio/reel_ltx",
                    "format": "mp4", "codec": "h264"}}
}
