{
  "_meta_workflow": "HunyuanVideo 1.5 720p image-to-video (cfg-distilled) — motion/physics lane, 121 frames @ 24fps (~5s). Feed it a styled frame from the Krea 2 stage (or any still). DualCLIPLoader pairs Qwen2.5-VL 7B with byT5 glyph encoder.",

  "1": {"class_type": "UNETLoader", "_meta": {"title": "hyv 1.5 720p i2v"},
        "inputs": {"unet_name": "hunyuanvideo1.5_720p_i2v_cfg_distilled_fp8_scaled.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "DualCLIPLoader", "_meta": {"title": "qwen2.5vl + byt5"},
        "inputs": {"clip_name1": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
                   "clip_name2": "byt5_small_glyphxl_fp16.safetensors",
                   "type": "hunyuan_video_15", "device": "default"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "hyv 1.5 vae"},
        "inputs": {"vae_name": "hunyuanvideo15_vae_fp16.safetensors"}},
  "4": {"class_type": "LoadImage", "_meta": {"title": "input_wireframe"},
        "inputs": {"image": "style_frame.png"}},
  "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "motion_prompt"},
        "inputs": {"clip": ["2", 0],
                   "text": "natural believable motion, accurate physics, cinematic camera, continuous single shot"}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "motion_negative"},
        "inputs": {"clip": ["2", 0],
                   "text": "jitter, flicker, morphing, deformed anatomy, scene cuts, watermark"}},
  "7": {"class_type": "HunyuanVideo15ImageToVideo", "_meta": {"title": "hyv i2v 121f"},
        "inputs": {"positive": ["5", 0], "negative": ["6", 0], "vae": ["3", 0],
                   "start_image": ["4", 0], "width": 1280, "height": 720,
                   "length": 121, "batch_size": 1}},
  "8": {"class_type": "KSampler", "_meta": {"title": "sample (cfg-distilled)"},
        "inputs": {"model": ["1", 0], "positive": ["7", 0], "negative": ["7", 1],
                   "latent_image": ["7", 2], "seed": 7, "steps": 20, "cfg": 1.0,
                   "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "9": {"class_type": "VAEDecode", "_meta": {"title": "decode frames"},
        "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
  "10": {"class_type": "CreateVideo", "_meta": {"title": "assemble 24fps"},
         "inputs": {"images": ["9", 0], "fps": 24.0}},
  "11": {"class_type": "SaveVideo", "_meta": {"title": "save motion pass"},
         "inputs": {"video": ["10", 0], "filename_prefix": "studio/motion_hyv",
                    "format": "mp4", "codec": "h264"}}
}
